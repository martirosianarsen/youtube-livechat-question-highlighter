{
  "manifest_version": 3,
  "name": "YouTube Live Chat Question Highlighter",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "Catch questions in YouTube Live Chat. Search, copy, and mark answers in a clean, focused question queue.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/live_chat*"],
      "js": ["shared.js", "panel.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Chat Questions",
    "default_icon": {
      "16": "icons/YT_LC_QH_16.png",
      "32": "icons/YT_LC_QH_32.png",
      "48": "icons/YT_LC_QH_48.png",
      "128": "icons/YT_LC_QH_128.png"
    }
  },
  "icons": {
    "16": "icons/YT_LC_QH_16.png",
    "19": "icons/YT_LC_QH_19.png",
    "32": "icons/YT_LC_QH_32.png",
    "38": "icons/YT_LC_QH_38.png",
    "48": "icons/YT_LC_QH_48.png",
    "128": "icons/YT_LC_QH_128.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
